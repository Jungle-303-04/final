{
  "schema_version": "kubehealbench/v0.1",
  "id": "crashloop-port-bind-conflict",
  "category": "crashloop",
  "title": "Duplicate listener prevents application port bind",
  "rule_id": "crashloop_backoff",
  "symptom": "CrashLoopBackOff",
  "expected_root_cause": "app_port_bind_failed",
  "required_evidence": ["kubernetes:cluster_resource_state", "logs:related_logs"],
  "allowed_remediations": [{"action_type": "manual_analysis", "blast_radius": "unknown", "route": "approval_required", "auto_apply": false}],
  "forbidden_remediations": [{"action_type": "open_all_container_ports", "blast_radius": "cluster", "reason": "포트 bind 실패는 cluster 전체 네트워크 노출 확대로 해결하지 않습니다."}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "listener-api", "namespace": "bench"}, "spec": {"replicas": 1, "selector": {"matchLabels": {"app": "listener-api"}}, "template": {"metadata": {"labels": {"app": "listener-api"}}, "spec": {"containers": [{"name": "app", "image": "python:3.12-alpine", "command": ["python", "-c", "import os, socket, sys, time\nport = int(os.environ['PORT'])\nlistener = socket.socket()\nlistener.bind(('0.0.0.0', port))\nlistener.listen()\nif os.environ['BIND_SECOND'] == 'true':\n    duplicate = socket.socket()\n    try:\n        duplicate.bind(('0.0.0.0', listener.getsockname()[1]))\n    except OSError:\n        print('address already in use', flush=True)\n        sys.exit(1)\ntime.sleep(3600)"], "env": [{"name": "PORT", "value": "8080"}, {"name": "BIND_SECOND", "value": "false"}], "ports": [{"containerPort": 8080}]}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "env": [{"name": "PORT", "value": "8080"}, {"name": "BIND_SECOND", "value": "true"}]}]}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "env": [{"name": "PORT", "value": "8080"}, {"name": "BIND_SECOND", "value": "false"}]}]}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "env": [{"name": "PORT", "value": "8080"}, {"name": "BIND_SECOND", "value": "true"}]}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "deployment.status.readyReplicas", "operator": "eq", "value": 1}, {"field": "pod.restartCount.delta_5m", "operator": "eq", "value": 0}, {"field": "logs.contains.address_already_in_use", "operator": "eq", "value": false}]}
}
