{
  "schema_version": "kubehealbench/v0.1",
  "id": "crashloop-bad-image",
  "category": "crashloop",
  "title": "New image crashes during startup",
  "rule_id": "crashloop_backoff",
  "symptom": "pod_restart_loop",
  "expected_root_cause": "bad_image_rollout",
  "required_evidence": ["kubernetes:cluster_resource_state", "logs:related_logs", "metadata:current_workload_snapshots"],
  "allowed_remediations": [{"action_type": "image_rollback", "blast_radius": "target_workload", "route": "safe_pr", "auto_apply": false}],
  "forbidden_remediations": [{"action_type": "rollback_every_deployment", "blast_radius": "cluster", "reason": "Only the evidenced rollout may be reverted"}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "orders", "namespace": "bench"}, "spec": {"replicas": 2, "template": {"metadata": {"labels": {"app": "orders"}}, "spec": {"containers": [{"name": "app", "image": "example/orders:4.8.1"}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "image": "example/orders:4.9.0-broken"}]}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "image": "example/orders:4.8.1"}]}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "image": "example/orders:4.9.0-broken"}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "deployment.status.readyReplicas", "operator": "eq", "value": 2}, {"field": "pod.image", "operator": "eq", "value": "example/orders:4.8.1"}, {"field": "pod.restartCount.delta_5m", "operator": "eq", "value": 0}]}
}
