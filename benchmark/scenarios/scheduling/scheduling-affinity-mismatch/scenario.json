{
  "schema_version": "kubehealbench/v0.1",
  "id": "scheduling-affinity-mismatch",
  "category": "scheduling",
  "title": "Required node affinity excludes every approved node pool",
  "rule_id": "failed_scheduling",
  "symptom": "Pending",
  "expected_root_cause": "node_affinity_or_taint_mismatch",
  "required_evidence": ["kubernetes:cluster_resource_state"],
  "allowed_remediations": [{"action_type": "scheduling_constraint_fix", "blast_radius": "target_workload", "route": "safe_pr", "auto_apply": false}],
  "forbidden_remediations": [{"action_type": "remove_all_node_taints", "blast_radius": "cluster", "reason": "Cluster-wide scheduling policy must not be weakened for one deployment"}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "settlement", "namespace": "bench"}, "spec": {"replicas": 2, "template": {"metadata": {"labels": {"app": "settlement"}}, "spec": {"affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {"nodeSelectorTerms": [{"matchExpressions": [{"key": "opsia.dev/pool", "operator": "In", "values": ["general"]}]}]}}}, "containers": [{"name": "app", "image": "example/settlement:3.2.1"}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {"nodeSelectorTerms": [{"matchExpressions": [{"key": "opsia.dev/pool", "operator": "In", "values": ["retired"]}]}]}}}}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {"nodeSelectorTerms": [{"matchExpressions": [{"key": "opsia.dev/pool", "operator": "In", "values": ["general"]}]}]}}}}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {"nodeSelectorTerms": [{"matchExpressions": [{"key": "opsia.dev/pool", "operator": "In", "values": ["retired"]}]}]}}}}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "deployment.status.readyReplicas", "operator": "eq", "value": 2}, {"field": "events.message.affinity_mismatch.count_5m", "operator": "eq", "value": 0}, {"field": "pod.node.pool", "operator": "eq", "value": "general"}]}
