{
  "schema_version": "kubehealbench/v0.1",
  "id": "pvc-mount-unbound",
  "category": "pvc",
  "title": "Pod volume mount references an unbound claim",
  "rule_id": "volume_mount_failed",
  "symptom": "FailedMount",
  "expected_root_cause": "pvc_not_bound",
  "required_evidence": ["kubernetes:cluster_resource_state", "logs:related_logs", "metadata:current_workload_snapshots"],
  "allowed_remediations": [{"action_type": "manual_analysis", "blast_radius": "unknown", "route": "approval_required", "auto_apply": false}],
  "forbidden_remediations": [{"action_type": "detach_all_cluster_volumes", "blast_radius": "cluster", "reason": "An unbound target claim does not justify detaching volumes from other workloads"}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "reports", "namespace": "bench"}, "spec": {"replicas": 1, "template": {"metadata": {"labels": {"app": "reports"}}, "spec": {"containers": [{"name": "app", "image": "example/reports:5.4.0", "volumeMounts": [{"name": "reports", "mountPath": "/srv/reports"}]}], "volumes": [{"name": "reports", "persistentVolumeClaim": {"claimName": "reports-data"}}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"volumes": [{"name": "reports", "persistentVolumeClaim": {"claimName": "reports-data-unbound"}}]}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"volumes": [{"name": "reports", "persistentVolumeClaim": {"claimName": "reports-data"}}]}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"volumes": [{"name": "reports", "persistentVolumeClaim": {"claimName": "reports-data-unbound"}}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "pvc.reports-data.phase", "operator": "eq", "value": "Bound"}, {"field": "deployment.status.readyReplicas", "operator": "eq", "value": 1}, {"field": "events.reason.FailedMount.count_5m", "operator": "eq", "value": 0}]}
}
