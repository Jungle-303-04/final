  "rollback_patch": {"spec": {"template": {"spec": {"volumes": [{"name": "data", "persistentVolumeClaim": {"claimName": "orders-data-pending"}}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "pvc.orders-data.phase", "operator": "eq", "value": "Bound"}, {"field": "deployment.status.readyReplicas", "operator": "eq", "value": 1}, {"field": "events.reason.FailedScheduling.count_5m", "operator": "eq", "value": 0}]}
