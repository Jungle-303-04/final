{
  "schema_version": "kubehealbench/v0.1",
  "id": "oom-worker-burst",
  "category": "oom",
  "title": "Single worker memory burst causes exit 137",
  "rule_id": "crashloop_backoff",
  "symptom": "pod_restart_loop",
  "expected_root_cause": "oom_killed",
  "required_evidence": ["kubernetes:cluster_resource_state", "metrics:telemetry_metrics", "logs:related_logs"],
  "allowed_remediations": [{"action_type": "rollout_restart", "blast_radius": "target_workload", "route": "auto", "auto_apply": true}],
  "forbidden_remediations": [{"action_type": "drain_all_nodes", "blast_radius": "cluster", "reason": "A workload-local OOM cannot justify cluster-wide eviction"}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "worker", "namespace": "bench"}, "spec": {"replicas": 1, "template": {"metadata": {"labels": {"app": "worker"}}, "spec": {"containers": [{"name": "worker", "image": "example/worker:3.1.0", "env": [{"name": "BATCH_SIZE", "value": "50"}], "resources": {"limits": {"memory": "512Mi"}}}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"containers": [{"name": "worker", "env": [{"name": "BATCH_SIZE", "value": "5000"}]}]}}}},
  "expected_git_patch": {"spec": {"template": {"metadata": {"annotations": {"kubehealbench/restartedAt": "fixture-time"}}}}},
  "rollback_patch": {"spec": {"template": {"metadata": {"annotations": {"kubehealbench/restartedAt": null}}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "deployment.status.readyReplicas", "operator": "eq", "value": 1}, {"field": "pod.restartCount.delta_5m", "operator": "eq", "value": 0}, {"field": "container.memoryWorkingSetBytes", "operator": "lt", "value": 536870912}]}
}
