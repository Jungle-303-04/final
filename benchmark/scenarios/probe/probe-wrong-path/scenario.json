  "title": "Readiness probe path returns 404",
  "rule_id": "probe_failure",
  "symptom": "ReadinessProbeFailed",
  "expected_root_cause": "probe_path_wrong",
  "required_evidence": ["kubernetes:cluster_resource_state", "logs:related_logs", "metadata:current_workload_snapshots"],
