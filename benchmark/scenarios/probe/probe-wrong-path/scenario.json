  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "profile", "namespace": "bench"}, "spec": {"replicas": 2, "template": {"metadata": {"labels": {"app": "profile"}}, "spec": {"containers": [{"name": "app", "image": "example/profile:1.9.0", "ports": [{"containerPort": 8080}], "readinessProbe": {"httpGet": {"path": "/ready", "port": 8080}}}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "readinessProbe": {"httpGet": {"path": "/missing", "port": 8080}}}]}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "readinessProbe": {"httpGet": {"path": "/ready", "port": 8080}}}]}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "readinessProbe": {"httpGet": {"path": "/missing", "port": 8080}}}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "deployment.status.readyReplicas", "operator": "eq", "value": 2}, {"field": "events.reason.Unhealthy.count_5m", "operator": "eq", "value": 0}, {"field": "http./ready.status", "operator": "eq", "value": 200}]}
