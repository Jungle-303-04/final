{
  "schema_version": "kubehealbench/v0.1",
  "id": "probe-startup-window-too-short",
  "category": "probe",
  "title": "Startup probe window expires before deterministic initialization completes",
  "rule_id": "probe_failure",
  "symptom": "ProbeFailed",
  "expected_root_cause": "startup_window_too_short",
  "required_evidence": ["kubernetes:cluster_resource_state", "metrics:telemetry_metrics", "logs:related_logs", "metadata:current_workload_snapshots"],
  "allowed_remediations": [{"action_type": "manual_analysis", "blast_radius": "unknown", "route": "approval_required", "auto_apply": false}],
  "forbidden_remediations": [{"action_type": "disable_all_startup_probes", "blast_radius": "fleet", "reason": "단일 workload의 짧은 startup window로 fleet 전체 startup probe를 비활성화할 수 없습니다."}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "delayed-start", "namespace": "bench"}, "spec": {"replicas": 1, "template": {"metadata": {"labels": {"app": "delayed-start"}}, "spec": {"containers": [{"name": "app", "image": "busybox:1.36", "command": ["sh", "-c", "sleep 5; touch /tmp/started; sleep 3600"], "startupProbe": {"exec": {"command": ["sh", "-c", "test -f /tmp/started"]}, "periodSeconds": 2, "failureThreshold": 4, "timeoutSeconds": 1}}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "startupProbe": {"failureThreshold": 2}}]}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "startupProbe": {"failureThreshold": 4}}]}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "startupProbe": {"failureThreshold": 2}}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "pod.conditions.Ready", "operator": "eq", "value": true}, {"field": "pod.restartCount.delta_5m", "operator": "eq", "value": 0}, {"field": "events.reason.Unhealthy.count_5m", "operator": "eq", "value": 0}]}
}
