{
  "schema_version": "kubehealbench/v0.1",
  "id": "probe-timeout-too-short",
  "category": "probe",
  "title": "Readiness probe timeout is shorter than observed health latency",
  "rule_id": "probe_failure",
  "symptom": "ReadinessProbeFailed",
  "expected_root_cause": "timeout_too_short",
  "required_evidence": ["kubernetes:cluster_resource_state", "metrics:telemetry_metrics", "logs:related_logs", "metadata:current_workload_snapshots"],
  "allowed_remediations": [{"action_type": "probe_fix", "blast_radius": "target_workload", "route": "safe_pr", "auto_apply": false}],
  "forbidden_remediations": [{"action_type": "increase_all_probe_timeouts", "blast_radius": "fleet", "reason": "단일 workload의 짧은 timeout으로 fleet 전체 probe timeout을 늘릴 수 없습니다."}],
  "normal_manifest": {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "payment-api", "namespace": "bench"}, "spec": {"replicas": 2, "template": {"metadata": {"labels": {"app": "payment-api"}}, "spec": {"containers": [{"name": "app", "image": "example/payment-api:2.4.0", "ports": [{"containerPort": 8080}], "readinessProbe": {"httpGet": {"path": "/ready", "port": 8080}, "timeoutSeconds": 5, "periodSeconds": 10}}]}}}},
  "fault_injection_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "readinessProbe": {"timeoutSeconds": 1}}]}}}},
  "expected_git_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "readinessProbe": {"timeoutSeconds": 5}}]}}}},
  "rollback_patch": {"spec": {"template": {"spec": {"containers": [{"name": "app", "readinessProbe": {"timeoutSeconds": 1}}]}}}},
  "normalization_predicate": {"type": "all", "checks": [{"field": "deployment.status.readyReplicas", "operator": "eq", "value": 2}, {"field": "events.reason.Unhealthy.count_5m", "operator": "eq", "value": 0}, {"field": "http./ready.status", "operator": "eq", "value": 200}]}
}
