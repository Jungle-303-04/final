# 아키텍처 의존 경계 강제 — import-linter (CI에서 lint-imports 실행).
# 규칙: services → domains → packages (안쪽 커널로만 의존). 역방향 금지.
# 예외 1곳(의도적): storage 합성 루트(도메인 자동 발견).
#
# services 가 root 가 아닌 이유: 서비스 디렉터리는 하이픈(예: command-worker)이라 Python 패키지로
# import 불가 + 스크립트 entrypoint(from settings ...)다. 즉 서비스끼리 import 자체가 구조적으로
# 불가능하므로 별도 계약이 필요 없다. domains/packages 가 services 를 안 쓰는 것만 아래에서 강제.

[importlinter]
root_packages =
    packages
    domains
include_external_packages = True

[importlinter:contract:layered]
name = Layered: domains(위) → packages(아래), 역방향 금지
type = layers
layers =
    domains
    packages
ignore_imports =
    # 합성 루트: 동적 Database/테이블 로딩(도메인 자동 발견)
    packages.storage.database -> domains.registry
    packages.storage.engine -> domains.registry

[importlinter:contract:no-services-in-lib]
name = packages/domains 는 services 를 import 하지 않음
type = forbidden
source_modules =
    packages
    domains
forbidden_modules =
    services

[importlinter:contract:release-flow-internals-no-router]
name = release flow 내부 모듈은 router 를 역참조하지 않음
type = forbidden
source_modules =
    domains.release_flow._support
    domains.release_flow.policy
    domains.release_flow.readiness
    domains.release_flow.report
    domains.release_flow.verification
forbidden_modules =
    domains.release_flow.router

[importlinter:contract:release-flow-support-leaf]
name = release flow support 는 업무 모듈을 참조하지 않음
type = forbidden
source_modules =
    domains.release_flow._support
forbidden_modules =
    domains.release_flow.policy
    domains.release_flow.readiness
    domains.release_flow.report
    domains.release_flow.verification

[importlinter:contract:release-flow-policy-direction]
name = release flow policy 는 상위 조립과 report 를 참조하지 않음
type = forbidden
source_modules =
    domains.release_flow.policy
forbidden_modules =
    domains.release_flow.readiness
    domains.release_flow.report
    domains.release_flow.verification

[importlinter:contract:release-flow-verification-direction]
name = release flow verification 은 policy 와 상위 모듈을 참조하지 않음
type = forbidden
source_modules =
    domains.release_flow.verification
forbidden_modules =
    domains.release_flow.policy
    domains.release_flow.readiness
    domains.release_flow.report

[importlinter:contract:release-flow-readiness-report-direction]
name = release flow readiness 와 report 의 단방향 의존을 유지
type = forbidden
source_modules =
    domains.release_flow.readiness
forbidden_modules =
    domains.release_flow.report

# bodies facade 해체 완료: 이벤트 body 는 소유 도메인에서 직접 import 하고,
# facade 는 커널(EventBody/JsonObject) + 문자열 기반 lazy shim 만 남아
# 도메인 의존 그래프가 실제 import 에 그대로 드러난다.
#
# 도메인별 fine-grained 독립성 계약은 storage registry 간접 의존과
# identity → mail 이벤트 발행 경계를 분리한 뒤 추가한다.
