DATABASE_URL=postgresql://service:service@localhost:5432/service
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379/0
TARGET_CLUSTER_ID=target-cluster-01
EVIDENCE_INTERVAL_SECONDS=8
PORT=8000

# Open-source/deploy friendly resource prefix.
PROJECT_SLUG=kubeheal

# Secret refs. 기본 auto는 env:/unprefixed ref를 환경변수에서 읽고,
# aws-sm: ref는 AWS Secrets Manager adapter로 라우팅합니다.
SECRET_VAULT_PROVIDER=auto
TOKEN_VAULT_PROVIDER=auto
SECRET_VAULT_AWS_REGION=
GITHUB_TOKEN_REF=env:GITHUB_TOKEN

# GitOps manifest source policy. Dev can use local files; hosted/prod should use remote refs.
GIT_MANIFEST_SOURCE_MODE=auto
GIT_LOCAL_MANIFEST_ENABLED=0
GIT_REMOTE_MANIFEST_ENABLED=1
GIT_REMOTE_MANIFEST_REQUIRED=1
GITOPS_REQUIRE_APPROVED_SNAPSHOT=0

# LLM Gateway. 기본 fake는 키 없이 로컬/CI에서 동작합니다.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024

# provider별 실제 키는 Kubernetes Secret 또는 로컬 env로 주입합니다.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
