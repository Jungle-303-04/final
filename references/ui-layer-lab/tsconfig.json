{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/registry/new-york-v4/*": ["./vendor/shadcn/upstream/registry/new-york-v4/*"],
      "@/registry/bases/base/ui/*": ["./src/components/ui/*"],
      "@/registry/bases/base/hooks/*": ["./src/hooks/*"],
      "@/registry/bases/base/lib/*": ["./src/lib/*"],
      "@/registry/bases/base/*": ["./vendor/shadcn/upstream/registry/bases/base/*"],
      "@/styles/base-nova/*": ["./vendor/shadcn/upstream/styles/base-nova/*"],
      "@/styles/base-rhea/*": ["./vendor/shadcn/upstream/styles/base-rhea/*"],
      "@/styles/radix-nova/*": ["./vendor/shadcn/upstream/styles/radix-nova/*"],
      "@/styles/radix-rhea/*": ["./vendor/shadcn/upstream/styles/radix-rhea/*"],
      "@/app/(create)/components/icon-placeholder": ["./src/shadcn-lab/shims/icon-placeholder.tsx"],
      "@/lib/ai": ["./vendor/shadcn/upstream/support/ai.ts"],
      "@/components/message-parts": ["./vendor/shadcn/upstream/support/message-parts.tsx"],
      "@/components/language-selector": ["./vendor/shadcn/upstream/support/language-selector.tsx"],
      "@/components/markdown": ["./vendor/shadcn/upstream/support/markdown.tsx"],
      "@/components/message-animated": ["./vendor/shadcn/upstream/support/message-animated.tsx"],
      "@/lib/message-animations": ["./vendor/shadcn/upstream/support/message-animations.ts"],
      "@/registry/icons/__lucide__": ["./vendor/shadcn/upstream/support/__lucide__.ts"],
      "@/hooks/use-media-query": ["./vendor/shadcn/upstream/support/use-media-query.tsx"],
      "@/hooks/use-copy-to-clipboard": ["./vendor/shadcn/upstream/support/use-copy-to-clipboard.ts"],
      "next/link": ["./src/shadcn-lab/shims/next-link.tsx"],
      "next/image": ["./src/shadcn-lab/shims/next-image.tsx"],
      "next/form": ["./src/shadcn-lab/shims/next-form.tsx"],
      "next/font/google": ["./src/shadcn-lab/shims/next-font-google.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts/fixtures/**/*.tsx"]
}
