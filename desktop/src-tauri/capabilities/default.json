{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The sole Opsia webview may call the explicitly listed local bridge commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-desktop-capabilities",
    "allow-desktop-set-active-cluster-title",
    "allow-desktop-open-external-url",
    "allow-desktop-save-file",
    "allow-desktop-open-saved-file",
    "allow-desktop-reveal-saved-file",
    "allow-desktop-system-theme"
  ]
}
