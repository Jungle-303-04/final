meta {
  name: 02 Get Conversation
  type: http
  seq: 2
  tags: [
    ai
    read
  ]
}

get {
  url: {{base_url}}/ai/conversations/{{conversation_id}}
}

test {
  test("conversation is returned or missing data is explicit", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });

  test("success body has conversation and messages", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("conversation");
      expect(body.messages).to.be.an("array");
    }
  });
}
