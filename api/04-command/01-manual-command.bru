meta {
  name: 01 Manual Command
  type: http
  seq: 1
  tags: [
    command
    session
    write
  ]
}

post {
  url: {{base_url}}/commands
}

headers {
  content-type: application/json
}

body {
  {
    "cluster_id": "{{cluster_id}}",
    "action": "rollout_restart",
    "namespace": "sandbox",
    "reason": "manual Bruno command test",
    "approval_ref": "approval-bruno-manual",
    "policy_decision_ref": "policy-bruno-manual",
    "diff": {
      "workspace_id": "{{workspace_id}}",
      "cluster_id": "{{cluster_id}}",
      "application_id": "app-bruno",
      "workflow_run_id": "wf-bruno",
      "binding_id": "binding-bruno",
      "environment": "sandbox",
      "namespace": "sandbox",
      "resource_kind": "Deployment",
      "resource_name": "checkout-api",
      "action": "modify",
      "risk": "sandbox-only",
      "desired_manifest": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "checkout-api",
          "namespace": "sandbox"
        }
      },
      "actual_manifest": {}
    }
  }
}

test {
  test("accepted or explicit auth/access/validation failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has event id", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("event_id");
      expect(body).to.have.property("correlation_id");
    }
  });
}
