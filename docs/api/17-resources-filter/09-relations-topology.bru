meta {
  name: 09 단일 클러스터 관계 토폴로지
  type: http
  seq: 9
  tags: [resources, topology, relations, read]
}

get {
  url: {{base_url}}topology?view=relations&clusters={{cluster_id}}
}

tests {
  test("200 or validated access/snapshot failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422, 503]).to.include(res.status);
  });

  test("200 response is the exact BQ-075 relation graph", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(Object.keys(body).sort()).to.deep.equal(["edges", "nodes"]);
    expect(body.nodes).to.be.an("array");
    expect(body.edges).to.be.an("array");
    body.nodes.forEach((node) => {
      expect(Object.keys(node).sort()).to.deep.equal(["id", "kind", "name", "status"]);
    });
    body.edges.forEach((edge) => {
      expect(Object.keys(edge).sort()).to.deep.equal(["from", "to", "type"]);
      expect(["owns", "runs_on", "selects", "routes_to"]).to.include(edge.type);
    });
  });
}
