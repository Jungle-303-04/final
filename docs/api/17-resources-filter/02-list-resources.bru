meta {
  name: 02 워크스페이스 Resources 조회
  type: http
  seq: 2
  tags: [resources, filters, read]
}

get {
  url: {{base_url}}resources?clusters={{cluster_id}}&limit=50
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 409, 422]).to.include(res.status);
  });

  test("200 response exposes server counts and strict rows", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    expect(body).to.have.property("counts");
    expect(body.counts).to.have.property("filtered_count");
    expect(body.counts).to.have.property("unfiltered_count");
    expect(body).to.have.property("snapshot");
  });
}
