meta {
  name: 08 Resource action capabilities
  type: http
  seq: 8
  tags: [resources, capabilities, rbac, read]
}

get {
  url: {{base_url}}capabilities?resource={{resource_id}}
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("200 response exposes only executable resource actions", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.subject.resource_id).to.equal(bru.getVar("resource_id"));
    expect(body.revision).to.match(/^[0-9a-f]{64}$/);
    expect(body.capabilities).to.be.an("array");
    body.capabilities.forEach((capability) => {
      expect(["deployment.restart", "deployment.scale"]).to.include(
        capability.capability_id
      );
      expect(capability.method).to.equal("POST");
      expect(capability.path).to.match(/^\//);
    });
  });
}
