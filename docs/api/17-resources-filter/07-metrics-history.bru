meta {
  name: 07 Resources pod 메트릭 배치 이력
  type: http
  seq: 7
  tags: [resources, metrics, history, read]
}

get {
  url: {{base_url}}metrics/history?ids={{resource_id}}&clusters={{cluster_id}}&range=1h&limit=60
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("200 response exposes honest batched metric history", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.series).to.be.an("array");
    expect(body).to.have.property("completeness");
    expect(body).to.have.property("snapshot");
    body.series.forEach((series) => {
      expect(series).to.have.property("has_sparkline_points");
      expect(series).to.have.property("completeness");
      expect(series.points).to.be.an("array");
      if (!series.has_sparkline_points) {
        expect(series.points.every((point) => point.cpu_mcores === null)).to.equal(true);
      }
    });
  });
}
