meta {
  name: 04 단일 클러스터 리소스 그래프
  type: http
  seq: 4
  tags: [resources, graph, read]
}

get {
  url: {{base_url}}resources/graph?clusters={{cluster_id}}&max_nodes=200&max_edges=1000
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("200 response exposes bounded evidence-backed graph", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.nodes).to.be.an("array");
    expect(body.edges).to.be.an("array");
    expect(body).to.have.property("counts");
    expect(body).to.have.property("snapshot");
    expect(body).to.have.property("relation_completeness");
    expect(body).to.have.property("truncated");
  });
}
