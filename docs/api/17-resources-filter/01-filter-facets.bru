meta {
  name: 01 구조 필터 facet 목록
  type: http
  seq: 1
  tags: [resources, filters, read]
}

get {
  url: {{base_url}}resources/filter-facets?axis=clusters&limit=50
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 409, 422]).to.include(res.status);
  });

  test("200 response exposes cursor and snapshot metadata", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    expect(body).to.have.property("has_more");
    expect(body).to.have.property("snapshot");
    expect(body.snapshot).to.have.property("snapshot_revision");
  });
}
