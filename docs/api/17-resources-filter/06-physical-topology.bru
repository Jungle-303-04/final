meta {
  name: 06 단일 클러스터 물리 토폴로지
  type: http
  seq: 6
  tags: [resources, topology, read]
}

get {
  url: {{base_url}}topology?view=physical&clusters={{cluster_id}}
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("200 response exposes bounded server-authoritative placement", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.view).to.equal("physical");
    expect(body).to.have.property("cluster_projection_revision");
    expect(body.servers).to.be.an("array");
    expect(body.pods).to.be.an("array");
    expect(body).to.have.property("truncated");
    expect(body).to.have.property("counts");
    expect(body).to.have.property("projection_completeness");
    expect(body).to.have.property("metrics_completeness");
    expect(body).to.have.property("snapshot");
    body.servers.forEach((server) => {
      expect(server).to.have.property("matched_pod_count");
      expect(server).to.have.property("total_pod_count");
      expect(server).to.have.property("matched_pod_count_completeness");
      expect(server).to.have.property("total_pod_count_completeness");
    });
    body.pods.forEach((pod) => {
      expect(pod).to.have.property("server_id");
      expect(pod).to.have.property("matches_filter");
      expect(pod).to.have.property("restarts");
    });
  });
}
