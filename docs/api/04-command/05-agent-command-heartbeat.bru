meta {
  name: 05 Command Heartbeat
  type: http
  seq: 5
  tags: [
    command
    agent
  ]
}

post {
  url: {{base_url}}agent/commands/{{command_id}}/heartbeat
  body: json
}

headers {
  content-type: application/json
  x-agent-token: {{agent_token}}
}

body:json {
  {
    "cluster_id": "{{agent_cluster_id}}",
    "workspace_id": "{{workspace_id}}",
    "agent_id": "{{agent_id}}",
    "lease_id": "{{lease_id}}"
  }
}

tests {
  test("accepted or explicit command/auth failure", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body has correlation id", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("correlation_id");
    }
  });
}
