meta {
  name: 07 Command 상태·결과 조회
  type: http
  seq: 7
  tags: [
    command
    telemetry
    read
  ]
}

get {
  url: {{base_url}}commands/{{command_id}}
}

tests {
  test("ok or explicit auth/access/not-found failure", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });

  test("success body has status and result", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("command_id");
      expect(body).to.have.property("cluster_id");
      expect(body).to.have.property("status");
      expect(body).to.have.property("result");
    }
  });
}
