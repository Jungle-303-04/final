meta {
  name: 01 AI 대화 생성
  type: http
  seq: 1
  tags: [
    ai
    write
  ]
}

post {
  url: {{base_url}}ai/conversations
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "Bruno RCA practice",
    "agent": "operations-chat",
    "message": "cluster_id={{cluster_id}} 에서 최근 RCA 타임라인을 보고 다음 조치를 정리해줘.",
    "context": {
      "workspace_id": "{{workspace_id}}",
      "cluster_id": "{{cluster_id}}",
      "source": "bruno"
    }
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.conversation_id) {
    bru.setVar("conversation_id", body.conversation_id);
  }
}

tests {
  test("accepted or explicit auth/validation failure", function () {
    expect([200, 401, 403, 422, 503]).to.include(res.status);
  });

  test("success body has conversation and message ids", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("conversation_id");
      expect(body).to.have.property("message_id");
      expect(body).to.have.property("event_id");
      expect(body).to.have.property("correlation_id");
    }
  });
}
