meta {
  name: 05 AI 대화 삭제
  type: http
  seq: 5
  tags: [
    ai
    write
  ]
}

delete {
  url: {{base_url}}ai/conversations/{{conversation_id}}
}

tests {
  test("delete is explicit success/auth/not-found", function () {
    expect([204, 401, 403, 404]).to.include(res.status);
  });

  test("success has no response body", function () {
    if (res.status === 204) {
      expect(res.getBody()).to.satisfy(function (body) {
        return body === null || body === undefined || body === "";
      });
    }
  });
}
