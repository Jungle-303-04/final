meta {
  name: 03 Append Message
  type: http
  seq: 3
  tags: [
    ai
    write
  ]
}

post {
  url: {{base_url}}/ai/conversations/{{conversation_id}}/messages
}

headers {
  content-type: application/json
}

body {
  {
    "message": "위 대화 기준으로 민정, 가인, 찬빈이 각각 다음에 확인해야 할 값을 나눠줘.",
    "agent": "operations-chat",
    "context": {
      "workspace_id": "{{workspace_id}}",
      "cluster_id": "{{cluster_id}}",
      "source": "bruno-followup"
    }
  }
}

test {
  test("message is accepted or missing conversation/auth is explicit", function () {
    expect([200, 401, 403, 404, 422, 503]).to.include(res.status);
  });

  test("success body has message event", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("conversation_id");
      expect(body).to.have.property("message_id");
      expect(body).to.have.property("event_id");
    }
  });
}
