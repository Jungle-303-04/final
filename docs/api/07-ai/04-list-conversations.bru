meta {
  name: 04 AI 대화 목록 조회
  type: http
  seq: 4
  tags: [
    ai
    read
  ]
}

get {
  url: {{base_url}}ai/conversations
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.conversations) && body.conversations.length) {
    bru.setVar("conversation_id", body.conversations[0].conversation_id);
  }
}

tests {
  test("conversation list is returned or auth blocks clearly", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body has conversations array", function () {
    if (res.status === 200) {
      expect(res.getBody().conversations).to.be.an("array");
    }
  });
}
