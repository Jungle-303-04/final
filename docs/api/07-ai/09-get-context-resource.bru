meta {
  name: 09 AI 리소스 상세
  type: http
  seq: 9
  tags: [ai, resources, read]
}

get {
  url: {{base_url}}ai/resources/deployments/{{namespace}}/{{deployment_name}}?cluster_id={{cluster_id}}
}

tests {
  test("resource is returned or absence/access is explicit", function () {
    expect([200, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("successful detail remains token-bounded", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body).to.have.all.keys(
      "id", "cluster_id", "resource_type", "kind", "namespace", "name",
      "status", "health", "observed_at", "link"
    );
  });
}
