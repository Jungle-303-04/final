meta {
  name: 05 배포 바인딩 생성(클러스터 연결)
  type: http
  seq: 5
  tags: [applications, deployment, write]
}

post {
  url: {{base_url}}applications/{{application_id}}/deployments
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "namespace": "{{namespace}}",
    "environment": "dev",
    "manifest_path": "{{manifest_path}}"
  }
}

tests {
  test("200 or auth/validation", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });
}
