meta {
  name: 02 애플리케이션 등록(레포 연결)
  type: http
  seq: 2
  tags: [applications, write]
}

post {
  url: {{base_url}}applications
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "gitops-demo",
    "repo_ref": "{{repo_ref}}",
    "default_branch": "{{default_branch}}",
    "manifest_path": "{{manifest_path}}"
  }
}

script:post-response {
  const b = res.getBody();
  if (res.status === 200 && b && b.application && b.application.application_id) {
    bru.setVar("application_id", b.application.application_id);
  }
}

tests {
  test("200 or auth/validation failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });
  test("success returns application", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("application");
    }
  });
}
