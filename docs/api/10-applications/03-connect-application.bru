meta {
  name: 03 애플리케이션 연결(검증 + 바인딩)
  type: http
  seq: 3
  tags: [applications, repository, deployment, write]
}

post {
  url: {{base_url}}applications/connect
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{application_name}}",
    "repo_ref": "{{repo_ref}}",
    "branch": "{{default_branch}}",
    "manifest_path": "{{manifest_path}}",
    "source_type": "{{source_type}}",
    "cluster_id": "{{cluster_id}}",
    "namespace": "{{namespace}}",
    "environment": "dev"
  }
}

script:post-response {
  const b = res.getBody();
  if (res.status === 200 && b && b.application && b.application.application_id) {
    bru.setVar("application_id", b.application.application_id);
  }
}

tests {
  test("200 or auth/validation failure", function () {
    expect([200, 400, 401, 403, 422]).to.include(res.status);
  });
  test("success returns application", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("application");
    }
  });
}
