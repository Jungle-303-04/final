meta {
  name: 06 워크플로우 run 목록
  type: http
  seq: 6
  tags: [applications, runs, read]
}

get {
  url: {{base_url}}applications/{{application_id}}/runs
}

tests {
  test("200 or auth/not-found", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });

  test("success exposes a machine-readable promotion gate", function () {
    if (res.status !== 200) return;
    expect(res.body.runs).to.be.an("array");
    res.body.runs
      .filter((run) => run.promotion_gate != null)
      .forEach((run) => {
        const gate = run.promotion_gate;
        expect(gate).to.include.all.keys(
          "eligible",
          "command_status",
          "command_completed",
          "applied_not_false",
          "failed_resources",
          "failed_resource_count",
          "rollout_ready_not_false"
        );
        expect(gate.failed_resources).to.be.an("array");
        expect(gate.failed_resource_count).to.equal(gate.failed_resources.length);
        expect(gate.eligible).to.equal(
          gate.command_completed &&
            gate.applied_not_false &&
            gate.failed_resource_count === 0 &&
            gate.rollout_ready_not_false
        );
      });
  });
}
