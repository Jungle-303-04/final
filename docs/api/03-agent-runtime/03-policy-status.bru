meta {
  name: 03 정책 적용 상태 보고
  type: http
  seq: 3
  tags: [
    agent
    policy
  ]
}

post {
  url: {{base_url}}agent/policy/status
  body: json
}

headers {
  content-type: application/json
  x-agent-token: {{agent_token}}
}

body:json {
  {
    "cluster_id": "{{agent_cluster_id}}",
    "generation": 2,
    "status": "applied",
    "message": "policy applied from Bruno",
    "details": {
      "checked_by": "bruno"
    }
  }
}

tests {
  test("accepted or explicit auth failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success accepted", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("accepted", true);
    }
  });
}
