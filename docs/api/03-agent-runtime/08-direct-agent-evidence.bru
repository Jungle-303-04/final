meta {
  name: 08 Direct Agent Evidence
  type: http
  seq: 8
  tags: [
    agent
    evidence
    rca
  ]
}

post {
  url: {{base_url}}agent/evidence
}

headers {
  content-type: application/json
  x-agent-token: {{agent_token}}
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "workspace_id": "{{workspace_id}}",
    "correlation_id": "corr-bruno-evidence-001",
    "agent_id": "{{agent_id}}",
    "source_id": "bruno-direct",
    "window_start": "2026-07-05T00:00:00Z",
    "evidence_key": "{{evidence_key}}",
    "kubernetes": {
      "pods": [
        {
          "namespace": "sandbox",
          "name": "checkout-api-abc",
          "phase": "Running",
          "ready": true,
          "restart_count": 0
        }
      ],
      "events": [],
      "nodes": [],
      "workloads": [],
      "services": [],
      "endpoints": []
    },
    "metrics": {
      "source": "prometheus",
      "results": {
        "pod_restart_rate": {
          "value": 0
        }
      }
    },
    "logs": [],
    "traces": {
      "source": "tempo",
      "results": {
        "target_agent_recent_spans": {
          "trace_count": 1
        }
      }
    }
  }
}

tests {
  test("accepted or explicit auth/validation failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has event id", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("event_id");
      expect(body).to.have.property("correlation_id");
    }
  });
}
