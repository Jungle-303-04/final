meta {
  name: 07 Evidence Job 결과 제출
  type: http
  seq: 7
  tags: [
    agent
    evidence
  ]
}

post {
  url: {{base_url}}agent/evidence/jobs/{{evidence_job_id}}/result
  body: json
}

headers {
  content-type: application/json
  x-agent-token: {{agent_token}}
}

body:json {
  {
    "agent_id": "{{agent_id}}",
    "lease_id": "{{lease_id}}",
    "status": "completed",
    "result": {
      "kubernetes": {
        "pods": [],
        "events": [],
        "nodes": [],
        "workloads": [],
        "services": [],
        "endpoints": []
      }
    },
    "error": ""
  }
}

tests {
  test("accepted or explicit job/auth failure", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body is evidence job result response", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("accepted", true);
    }
  });
}
