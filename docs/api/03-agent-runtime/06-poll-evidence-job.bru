meta {
  name: 06 Poll Evidence Job
  type: http
  seq: 6
  tags: [
    agent
    evidence
  ]
}

get {
  url: {{base_url}}agent/evidence/jobs/poll?provider_key={{provider_key}}&agent_id={{agent_id}}&timeout=1
}

headers {
  x-agent-token: {{agent_token}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.job && body.job.job_id) {
    bru.setVar("evidence_job_id", body.job.job_id);
    if (body.job.provider_key) {
      bru.setVar("provider_key", body.job.provider_key);
    }
  }
}

tests {
  test("200 with job/null or explicit auth failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has job key", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("job");
    }
  });
}
