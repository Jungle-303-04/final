meta {
  name: 04 Reconcile Status
  type: http
  seq: 4
  tags: [
    agent
    reconcile
  ]
}

post {
  url: {{base_url}}agent/reconcile/status
}

headers {
  content-type: application/json
  x-agent-token: {{agent_token}}
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "generation": 2,
    "status": "unchanged",
    "message": "checked from Bruno",
    "details": {
      "resources": []
    }
  }
}

tests {
  test("accepted or explicit auth failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success accepted", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("accepted", true);
    }
  });
}
