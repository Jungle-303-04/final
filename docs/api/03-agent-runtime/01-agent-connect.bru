meta {
  name: 01 Agent Connect
  type: http
  seq: 1
  tags: [
    agent
    write
  ]
}

post {
  url: {{base_url}}agent/connect
}

headers {
  content-type: application/json
  x-agent-token: {{agent_token}}
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "agent_id": "{{agent_id}}",
    "capabilities": [
      "commands",
      "collector",
      "kubernetes",
      "prometheus",
      "loki",
      "tempo"
    ]
  }
}

tests {
  test("accepted or explicit agent auth failure", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body has event id", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("event_id");
      expect(body).to.have.property("correlation_id");
    }
  });
}
