meta {
  name: 01 카탈로그 항목 목록
  type: http
  seq: 1
  tags: [catalog, read]
}

get {
  url: {{base_url}}catalog/items
}

script:post-response {
  const b = res.getBody();
  if (res.status === 200 && b && Array.isArray(b.items) && b.items.length) {
    const executable = b.items.find((item) => item.item_id === "catalog-postgresql");
    bru.setVar("catalog_item_id", executable ? executable.item_id : b.items[0].item_id);
  }
}

tests {
  test("200 or auth failure", function () {
    expect([200, 401, 403]).to.include(res.status);
  });
}
