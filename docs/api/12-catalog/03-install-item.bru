meta {
  name: 03 카탈로그 Helm 설치 요청
  type: http
  seq: 3
  tags: [catalog, write]
}

post {
  url: {{base_url}}catalog/items/{{catalog_item_id}}/installs
  body: json
}

headers {
  content-type: application/json
  Idempotency-Key: bruno-catalog-postgresql-001
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "namespace": "{{namespace}}",
    "application_name": "demo-postgresql",
    "release_name": "demo-postgresql",
    "values": {
      "auth.database": "demo",
      "primary.persistence.storageClass": "{{catalog_storage_class}}"
    }
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 202 && body && body.command_id) {
    bru.setVar("command_id", body.command_id);
  }
}

tests {
  test("accepted or explicit guard failure", function () {
    expect([202, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("accepted response exposes queryable command", function () {
    if (res.status === 202) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("command_id");
      expect(body).to.have.property("correlation_id");
      expect(body).to.have.property("status", "queued");
    }
  });
}
