meta {
  name: 02 실제 장애 생성과 Agent 감지 시작
  type: http
  seq: 2
  tags: [rca, test-run, write]
}

post {
  url: {{base_url}}rca/test-runs
  body: json
}

headers {
  content-type: application/json
  x-rca-test-token: {{rca_test_token}}
  x-rca-test-verification: {{rca_test_verification}}
}

body:json {
  {
    "cluster_id": "{{dev_cluster_id}}",
    "scenario_id": "{{rca_scenario_id}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 202 && body) {
    bru.setVar("rca_test_run_id", String(body.run_id || ""));
    bru.setVar("rca_correlation_id", String(body.correlation_id || ""));
    bru.setVar("rca_command_id", String(body.command_id || ""));
    bru.setVar("rca_evidence_key", String(body.evidence_key || ""));
    bru.setVar("rca_select_confirmation", "");
  }
}

tests {
  test("긴 evidence 없이 scenario_id만으로 실제 장애 실행을 큐잉한다", function () {
    expect(res.status).to.equal(202);
    const body = res.getBody();
    expect(body.accepted).to.equal(true);
    expect(body.scenario_id).to.equal(bru.getVar("rca_scenario_id"));
    expect(body.run_id).to.be.a("string").that.is.not.empty;
    expect(body.correlation_id).to.match(/^corr-rca-test-/);
    expect(body.status).to.equal("queued");
  });
}
