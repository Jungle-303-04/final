meta {
  name: 09 테스트 장애 Cleanup
  type: http
  seq: 9
  tags: [rca, test-run, cleanup, write]
}

delete {
  url: {{base_url}}rca/test-runs/{{rca_test_run_id}}
}

headers {
  x-rca-test-token: {{rca_test_token}}
}

tests {
  test("현재 run 소유 fixture만 cleanup 큐에 들어갔다", function () {
    expect(res.status).to.equal(202);
    expect(res.getBody().status).to.equal("cleanup_queued");
    const cleanup = res.getBody().steps.find((item) => item.step === "cleanup");
    expect(cleanup.status).to.equal("queued");
  });
}
