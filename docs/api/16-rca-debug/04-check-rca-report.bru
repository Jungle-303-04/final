meta {
  name: 04 RCA 원인 분석 결과 조회
  type: http
  seq: 4
  tags: [rca, debug, read]
}

get {
  url: {{base_url}}rca-reports?correlation_id={{rca_correlation_id}}&limit=20&offset=0
}

tests {
  test("wrong_image_tag RCA report가 완성됐다", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    if (body.items.length === 0) {
      throw new Error(`아직 RCA 분석 중입니다. 잠시 뒤 다시 보내세요: ${bru.getVar("rca_correlation_id")}`);
    }
    const report = body.items.find(
      (item) => item.correlation_id === bru.getVar("rca_correlation_id")
    );
    expect(report).to.be.an("object");
    expect(report.root_cause).to.equal("wrong_image_tag");
    expect(report.selected_candidate_id).to.equal("wrong_image_tag");
    expect(report.symptom).to.equal("ImagePullBackOff");
    expect(report.action).to.equal("plan_recovery");
    expect(report.confidence).to.be.at.least(0.9);
    expect(report.resource_name).to.equal(bru.getVar("rca_resource_name"));
    expect(report.missing_evidence).to.deep.equal([]);
  });
}
