meta {
  name: 01 등록된 실제 장애 시나리오 조회
  type: http
  seq: 1
  tags: [rca, test-run, read]
}

get {
  url: {{base_url}}rca/test-scenarios
}

headers {
  x-rca-test-token: {{rca_test_token}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.items)) {
    const scenarioId = String(bru.getVar("rca_scenario_id") || "image.wrong-tag");
    const scenario = body.items.find((item) => item.scenario_id === scenarioId);
    if (scenario) {
      bru.setVar("rca_expected_root_cause", String(scenario.expected.root_cause || ""));
      bru.setVar("rca_expected_symptom", String(scenario.expected.symptom || ""));
      bru.setVar("rca_scenario_version", String(scenario.version || ""));
    }
  }
}

tests {
  test("25개 원인 시나리오와 현재 실행 가능 상태를 확인한다", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.be.an("array").that.has.length(25);
    const scenario = body.items.find(
      (item) => item.scenario_id === bru.getVar("rca_scenario_id")
    );
    expect(scenario).to.be.an("object");
    expect(scenario.availability).to.equal("ready");
    expect(scenario.safety.namespace).to.equal("sandbox");
  });
}
