meta {
  name: 06 Recovery Plan과 사용자 선택 후보 조회
  type: http
  seq: 6
  tags: [rca, recovery, read]
}

get {
  url: {{base_url}}rca/recovery-plans/by-correlation/{{rca_correlation_id}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body) {
    bru.setVar("rca_plan_id", String(body.plan_id || ""));
    bru.setVar("rca_action_id", String(body.recommended_action_id || ""));
    bru.setVar("rca_action_route", String(body.execution_route || ""));
  }
}

tests {
  test("사람이 고를 후보와 추천 action이 준비됐다", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.status).to.equal("selection_requested");
    expect(body.selection_required).to.equal(true);
    expect(body.recommended_action_id).to.be.a("string").that.is.not.empty;
    expect(body.candidates.some((item) => item.action_id === body.recommended_action_id)).to.equal(true);
  });
}
