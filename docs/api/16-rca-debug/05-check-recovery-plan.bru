meta {
  name: 05 PR 직전 Recovery Plan 조회
  type: http
  seq: 5
  tags: [rca, recovery, debug, read]
}

get {
  url: {{base_url}}rca/recovery-plans/by-correlation/{{rca_correlation_id}}
}

tests {
  test("사람 선택이 필요한 Safe PR 후보가 준비됐다", function () {
    if (res.status === 404) {
      throw new Error(`아직 recovery plan 생성 전입니다. 잠시 뒤 다시 보내세요: ${bru.getVar("rca_correlation_id")}`);
    }
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.correlation_id).to.equal(bru.getVar("rca_correlation_id"));
    expect(body.status).to.equal("selection_requested");
    expect(body.execution_route).to.equal("draft_pr");
    expect(body.selection_required).to.equal(true);
    expect(body.recommended_action_id).to.be.a("string").that.is.not.empty;
    expect(body.candidates).to.be.an("array").that.is.not.empty;
    const recommended = body.candidates.find(
      (candidate) => candidate.action_id === body.recommended_action_id
    );
    expect(recommended).to.be.an("object");
    expect(recommended.route).to.equal("draft_pr");
    expect(recommended.approval_required).to.equal(true);
  });
}
