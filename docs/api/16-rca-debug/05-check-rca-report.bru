meta {
  name: 05 RCA 원인 분석 결과 조회
  type: http
  seq: 5
  tags: [rca, read]
}

get {
  url: {{base_url}}rca-reports?correlation_id={{rca_correlation_id}}&limit=20&offset=0
}

tests {
  test("선택한 시나리오의 기대 원인으로 분석됐다", function () {
    expect(res.status).to.equal(200);
    const report = res.getBody().items.find(
      (item) => item.correlation_id === bru.getVar("rca_correlation_id")
    );
    expect(report).to.be.an("object");
    expect(report.root_cause).to.equal(bru.getVar("rca_expected_root_cause"));
    expect(report.symptom).to.equal(bru.getVar("rca_expected_symptom"));
    expect(report.action).to.equal("plan_recovery");
  });
}
