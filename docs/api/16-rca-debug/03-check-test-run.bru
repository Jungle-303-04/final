meta {
  name: 03 전 과정 단계별 상태 조회
  type: http
  seq: 3
  tags: [rca, test-run, read]
}

get {
  url: {{base_url}}rca/test-runs/{{rca_test_run_id}}
}

headers {
  x-rca-test-token: {{rca_test_token}}
}

tests {
  test("장애부터 cleanup까지 모든 단계가 한 응답에 보인다", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.correlation_id).to.equal(bru.getVar("rca_correlation_id"));
    expect(body.steps.map((item) => item.step)).to.deep.equal([
      "fault_injection",
      "fault_observation",
      "evidence_collection",
      "root_cause_analysis",
      "recovery_plan",
      "action_selection",
      "cleanup"
    ]);
    if (body.status === "failed") {
      throw new Error(`파이프라인 실패: ${JSON.stringify(body.failure || {})}`);
    }
    if (["injecting", "collecting", "analyzing", "planning"].includes(body.status)) {
      throw new Error(`아직 처리 중입니다(${body.status}). 잠시 뒤 다시 보내세요.`);
    }
  });
}
