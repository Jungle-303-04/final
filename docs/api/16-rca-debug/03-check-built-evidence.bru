meta {
  name: 03 Evidence Worker 저장 결과 조회
  type: http
  seq: 3
  tags: [evidence, rca, debug, read]
}

get {
  url: {{base_url}}evidence?correlation_id={{rca_correlation_id}}&kind=rca_bundle&limit=20&offset=0
}

tests {
  test("evidence-worker가 동일 correlation의 결과를 저장했다", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    if (body.items.length === 0) {
      throw new Error(`아직 evidence-worker 처리 전입니다. 잠시 뒤 다시 보내세요: ${bru.getVar("rca_correlation_id")}`);
    }
    body.items.forEach((item) => {
      expect(item.correlation_id).to.equal(bru.getVar("rca_correlation_id"));
      expect(item.kind).to.equal("rca_bundle");
      expect(item.cluster_id).to.equal(bru.interpolate("{{dev_cluster_id}}"));
    });
    const sources = body.items.flatMap((item) => item.sources || []);
    expect(sources.some((source) => source.source === "kubernetes")).to.equal(true);
  });
}
