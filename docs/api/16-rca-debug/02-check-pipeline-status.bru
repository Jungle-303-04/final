meta {
  name: 02 현재 RCA 파이프라인 단계 조회
  type: http
  seq: 2
  tags: [dashboard, rca, debug, read]
}

get {
  url: {{base_url}}dashboard/rca/timeline?cluster_id={{dev_cluster_id}}&limit=100
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.items)) {
    const correlationId = String(bru.getVar("rca_correlation_id") || "");
    const row = body.items.find((item) => item.correlation_id === correlationId);
    if (row) {
      bru.setVar("rca_current_subject", String(row.current_subject || ""));
      bru.setVar("rca_current_status", String(row.status || ""));
      if (row.incident_id) {
        bru.setVar("incident_id", String(row.incident_id));
      }
    }
  }
}

tests {
  test("현재 correlation의 pipeline row가 보인다", function () {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    const correlationId = String(bru.getVar("rca_correlation_id") || "");
    const row = body.items.find((item) => item.correlation_id === correlationId);
    if (!row) {
      throw new Error(`아직 timeline projection 전입니다. 잠시 뒤 다시 보내세요: ${correlationId}`);
    }
    expect(row).to.have.property("current_subject");
    expect(row).to.have.property("status");
  });
}
