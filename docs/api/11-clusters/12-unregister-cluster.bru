meta {
  name: 12 클러스터 등록 해제
  type: http
  seq: 12
  tags: [clusters, admin, write]
}

delete {
  url: {{base_url}}clusters/{{cluster_id}}?purge={{cluster_purge}}
}

tests {
  test("204 or explicit auth/access/readonly/not-found failure", function () {
    expect([204, 400, 401, 403, 404]).to.include(res.status);
  });

  test("management readonly failure has code", function () {
    if (res.status === 400) {
      const detail = res.getBody().detail || {};
      expect(detail.code).to.be.oneOf(["management_readonly", "cluster_unregister_unsupported"]);
    }
  });
}
