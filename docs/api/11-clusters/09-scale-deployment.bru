meta {
  name: 09 디플로이먼트 스케일(sandbox)
  type: http
  seq: 9
  tags: [clusters, action, write, deploy]
}

post {
  url: {{base_url}}clusters/{{cluster_id}}/namespaces/{{namespace}}/deployments/{{deployment_name}}/scale
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "replicas": 1,
    "reason": "bruno scale test"
  }
}

tests {
  test("200 or auth/validation/not-found", function () {
    expect([200, 401, 403, 404, 409, 422]).to.include(res.status);
  });
}
