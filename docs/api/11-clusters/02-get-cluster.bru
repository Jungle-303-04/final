meta {
  name: 02 클러스터 상세
  type: http
  seq: 2
  tags: [clusters, read]
}

get {
  url: {{base_url}}clusters/{{cluster_id}}
}

tests {
  test("200 or auth/not-found", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });
  test("success exposes provider and connection stage", function () {
    if (res.status !== 200) { return; }
    const providers = ["eks", "gke", "aks", "onprem", "kind", "unknown"];
    const stages = ["awaiting_install", "agent_connected", "snapshot_received", "ready", "expired", "error"];
    expect(providers).to.include(res.getBody().cluster.provider);
    expect(stages).to.include(res.getBody().cluster.connection_stage);
  });
}
