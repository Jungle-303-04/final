meta {
  name: 11 클러스터 Usage 시계열 조회
  type: http
  seq: 11
  tags: [
    clusters
    usage
    dashboard
    read
  ]
}

get {
  url: {{base_url}}clusters/{{cluster_id}}/usage?limit=50
}

tests {
  test("200 or auth/not-found", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body has usage samples", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("cluster_id");
      expect(body).to.have.property("samples");
      expect(body.samples).to.be.an("array");
    }
  });
}
