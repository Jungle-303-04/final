meta {
  name: 02 Replay Dead Letter
  type: http
  seq: 2
  tags: [
    ops
    dlq
    write
  ]
}

post {
  url: {{base_url}}/dead-letters/{{dead_letter_id}}/replay
}

test {
  test("replay is accepted or dead letter state is explicit", function () {
    expect([200, 401, 403, 404, 409]).to.include(res.status);
  });

  test("success body has replay event", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("dead_letter_id");
      expect(body).to.have.property("replay_event");
    }
  });
}
