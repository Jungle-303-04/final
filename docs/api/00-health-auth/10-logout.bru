meta {
  name: 10 로그아웃
  type: http
  seq: 10
  tags: [
    auth
    session
  ]
}

post {
  url: {{base_url}}auth/logout
}

script:pre-request {
  const enabled = String(
    bru.getEnvVar("auth_flow_verification") || bru.getVar("auth_flow_verification") || "false"
  ).trim().toLowerCase() === "true";
  if (!enabled) {
    bru.runner.skipRequest();
  }
}

tests {
  test("200 after login, otherwise auth failure", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body clears authentication", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("authenticated", false);
    }
  });
}
