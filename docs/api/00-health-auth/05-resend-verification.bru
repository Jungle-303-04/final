meta {
  name: 05 이메일 검증 재전송
  type: http
  seq: 5
  tags: [
    auth
    write
  ]
}

post {
  url: {{base_url}}auth/resend-verification
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{signup_email}}",
    "password": "{{signup_password}}"
  }
}

tests {
  test("response is explicit", function () {
    expect([200, 400, 401, 404, 422, 429]).to.include(res.status);
  });

  test("success response contains verification flag", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("verification_required");
    }
  });
}
