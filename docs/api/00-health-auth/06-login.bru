meta {
  name: 06 로그인
  type: http
  seq: 6
  tags: [
    auth
    session
  ]
}

post {
  url: {{base_url}}auth/login
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{auth_email}}",
    "password": "{{auth_password}}"
  }
}

script:pre-request {
  const enabled = String(
    bru.getEnvVar("auth_flow_verification") || bru.getVar("auth_flow_verification") || "false"
  ).trim().toLowerCase() === "true";
  if (!enabled) {
    bru.runner.skipRequest();
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body) {
    if (body.workspace_id) {
      bru.setVar("workspace_id", body.workspace_id);
    }
    if (body.user_id) {
      bru.setVar("user_id", body.user_id);
    }
  }
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("authenticated session body", function () {
    const body = res.getBody();
    expect(body).to.have.property("authenticated", true);
    expect(body).to.have.property("user_id");
    expect(body).to.have.property("workspace_id");
    expect(body.roles).to.be.an("array");
  });
}
