meta {
  name: 07 세션 확인
  type: http
  seq: 7
  tags: [
    auth
    session
  ]
}

get {
  url: {{base_url}}auth/session
}

tests {
  const baseUrl = String(bru.getEnvVar("base_url") || bru.getVar("base_url") || "");
  const mtlsDevelopmentEndpoint = baseUrl.includes("dev-k8s.woonyong.org");

  test("mTLS development endpoint requires an authenticated session response", function () {
    if (mtlsDevelopmentEndpoint) {
      expect(res.status).to.equal(200);
      return;
    }
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body is authenticated", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("authenticated", true);
      if (mtlsDevelopmentEndpoint) {
        expect(body).to.have.property("workspace_id", "default");
        expect(body.roles).to.include("service_admin");
      }
    }
  });
}
