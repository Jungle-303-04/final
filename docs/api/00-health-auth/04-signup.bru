meta {
  name: 04 사용자 가입 요청
  type: http
  seq: 4
  tags: [
    auth
    write
  ]
}

post {
  url: {{base_url}}auth/signup
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{signup_email}}",
    "password": "{{signup_password}}",
    "password_confirm": "{{signup_password}}"
  }
}

script:pre-request {
  const enabled = String(
    bru.getEnvVar("auth_flow_verification") || bru.getVar("auth_flow_verification") || "false"
  ).trim().toLowerCase() === "true";
  if (!enabled) {
    bru.runner.skipRequest();
  }
}

tests {
  test("accepted or duplicate/rate-limited response is explicit", function () {
    expect([200, 400, 409, 422, 429]).to.include(res.status);
  });

  test("success response explains verification state", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("verification_required");
    }
  });
}
