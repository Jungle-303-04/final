meta {
  name: 01 워크스페이스 Issues 조회
  type: http
  seq: 1
  tags: [issues, filters, read]
}
get {
  url: {{base_url}}issues?clusters={{cluster_id}}&limit=50
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("200 response exposes mutable projection completeness", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    expect(body).to.have.property("counts");
    expect(body).to.have.property("capabilities");
    expect(body.snapshot).to.have.property("snapshot_revision", 0);
    expect(body.snapshot.partial_reason_codes).to.include("mutable_timeline_projection");
  });
}
