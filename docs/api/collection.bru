vars:pre-request {
  base_url: https://k8s.woonyong.org/
  auth_email: admin.local@example.com
  auth_password: local-test-password-1234
  signup_email: teammate@example.com
  signup_password: teammate-password-1234
  email_verification_token: replace-with-token-from-mail-event
  user_id: replace-with-user-id
  workspace_id: default
  cluster_id: cluster-1
  cluster_id_2: cluster-2
  target_name: cluster-1
  management_base_url: https://k8s.woonyong.org/
  service_image: replace-with-ecr-image-uri
  namespace: sandbox
  deployment_name: demo-web
  repo_ref: Jungle-303-04/gitops-demo
  default_branch: main
  manifest_path: deploy.yaml
  application_id: replace-with-application-id
  agent_token: replace-with-agent-token-from-target-registration
  agent_id: target-agent
  command_id: replace-with-command-id-from-poll-or-debug-query
  lease_id: lease-manual-001
  evidence_key: aws-window-001
  evidence_job_id: replace-with-job-id-from-evidence-job-poll
  provider_key: kubernetes
  catalog_item_id: replace-with-catalog-item-id
  plan_id: replace-with-recovery-plan-id
  action_id: replace-with-recovery-action-id
  approval_id: replace-with-approval-id
  dead_letter_id: 1
  conversation_id: replace-with-conversation-id
  incident_id: replace-with-incident-id
  org_id: default
  group_id: default
  access_id: replace-with-access-id
  metrics_token: replace-with-metrics-token-if-enabled
  github_webhook_signature: sha256=replace-with-valid-hmac
}
