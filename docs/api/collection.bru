vars:pre-request {
  base_url: https://dev-k8s.woonyong.org/api/
  auto_login: false
  auth_flow_verification: false
  auth_email: replace-with-auth-email
  auth_password: replace-with-auth-password
  signup_email: replace-with-signup-email
  signup_password: replace-with-signup-password
  check_email: bruno-validation@example.invalid
  email_verification_token: replace-with-token-from-mail-event
  user_id: replace-with-user-id
  workspace_id: default
  cluster_id: api-verification-target
  cluster_id_2: api-verification-target
  agent_cluster_id: api-verification-target
  cluster_purge: false
  target_name: API Verification Target
  agent_target_name: API Verification Target
  management_base_url: https://dev-k8s.woonyong.org/api/
  service_image: 183548421506.dkr.ecr.ap-northeast-2.amazonaws.com/kubernetes-ops-service@sha256:5f02d9694e812c594b28aebb3b5c8989afecb94a7b48109b9a8c5e0088a472b8
  namespace: sandbox
  deployment_name: checkout-api
  pod_name: replace-with-pod-name
  node_name: replace-with-node-name
  repo_ref: Jungle-303-04/final
  default_branch: main
  manifest_path: src/samples/smoke/deploy.yaml
  source_type: raw-yaml
  application_id: replace-with-application-id
  agent_token: replace-with-agent-token-from-target-registration
  agent_id: target-agent
  command_id: replace-with-command-id-from-poll-or-debug-query
  lease_id: lease-manual-001
  evidence_key: aws-window-001
  evidence_source: metadata
  rca_correlation_id: run-16-rca-debug-01-first
  rca_scenario_id: image.wrong-tag
  rca_test_verification: false
  rca_test_run_id: run-02-start-test-run-first
  rca_select_confirmation: CONFIRM_ONLY_BEFORE_STEP_07
  rca_event_id: run-16-rca-debug-01-first
  evidence_job_id: replace-with-job-id-from-evidence-job-poll
  provider_key: kubernetes
  catalog_item_id: replace-with-catalog-item-id
  plan_id: replace-with-recovery-plan-id
  action_id: replace-with-recovery-action-id
  approval_id: replace-with-approval-id
  dead_letter_id: 1
  conversation_id: replace-with-conversation-id
  incident_id: replace-with-incident-id
  org_id: default
  created_org_id: replace-with-created-org-id
  group_id: default
  access_id: replace-with-access-id
  alert_channel_id: replace-with-alert-channel-id
  alert_webhook_url: https://example.invalid/service-alerts
  metrics_token: replace-with-metrics-token-if-enabled
  alertmanager_token: replace-with-ALERTMANAGER_WEBHOOK_TOKEN
  github_webhook_signature: sha256=replace-with-valid-hmac
}

script:pre-request {
  const truthy = (value) => !["0", "false", "off", "no"].includes(String(value || "").trim().toLowerCase());
  const readVar = (name, fallback = "") => {
    const envValue = bru.getEnvVar(name);
    if (envValue !== undefined && envValue !== null && String(envValue).trim() !== "") {
      return String(envValue);
    }
    const runtimeValue = bru.getVar(name);
    if (runtimeValue !== undefined && runtimeValue !== null && String(runtimeValue).trim() !== "") {
      return String(runtimeValue);
    }
    const interpolated = bru.interpolate(`{{${name}}}`);
    if (interpolated && interpolated !== `{{${name}}}`) {
      return interpolated;
    }
    return fallback;
  };

  let rawPath = req.getPath();
  try {
    rawPath = new URL(req.getUrl()).pathname;
  } catch (_error) {
    rawPath = req.getPath();
  }
  const pathWithApiPrefix = rawPath.replace(/^\/api(?=\/)/, "");
  const path = pathWithApiPrefix.length > 1
    ? pathWithApiPrefix.replace(/\/+$/, "")
    : pathWithApiPrefix;
  const tags = req.getTags();
  const skipPaths = [
    "/healthz",
    "/readyz",
    "/openapi.json",
    "/auth/login",
    "/auth/signup",
    "/auth/resend-verification",
    "/auth/verify-email",
    "/auth/logout",
    "/github/webhook",
    "/webhooks/alertmanager",
    "/metrics"
  ];
  const sessionCookieName = "service_session";
  const agentRequest = tags.includes("agent") || Boolean(req.getHeader("x-agent-token"));
  if (path === "/auth/login") {
    bru.cookies.delete(sessionCookieName);
    req.deleteHeader("cookie");
    req.deleteHeader("Cookie");
  }
  const shouldSkipAutoLogin =
    !truthy(readVar("auto_login", "false")) ||
    tags.includes("public") ||
    skipPaths.includes(path) ||
    path.startsWith("/install/") ||
    agentRequest;

  if (!shouldSkipAutoLogin && !bru.cookies.get(sessionCookieName)) {
    const baseUrl = readVar("base_url").replace(/\/+$/, "");
    const email = readVar("auth_email");
    const password = readVar("auth_password");
    if (!baseUrl || !email || !password) {
      throw new Error("auto_login requires base_url, auth_email, and auth_password");
    }

    let loginResponse;
    try {
      loginResponse = await bru.sendRequest({
        method: "POST",
        url: `${baseUrl}/auth/login`,
        headers: { "Content-Type": "application/json" },
        data: { email, password },
        timeout: 10000
      });
    } catch (error) {
      const errorStatus = error && error.response ? error.response.status : "";
      const statusSuffix = errorStatus ? ` with status ${errorStatus}` : "";
      throw new Error(`auto_login failed${statusSuffix}: ${error.message}`);
    }
    const status = loginResponse.status || loginResponse.statusCode;
    const body = loginResponse.data || loginResponse.body || {};
    if (status !== 200) {
      throw new Error(`auto_login failed with status ${status}`);
    }

    if (body.workspace_id) {
      bru.setVar("workspace_id", body.workspace_id);
    }
    if (body.user_id) {
      bru.setVar("user_id", body.user_id);
    }

    const headers = loginResponse.headers || {};
    const setCookieHeader = headers["set-cookie"] || headers["Set-Cookie"];
    const setCookies = Array.isArray(setCookieHeader)
      ? setCookieHeader
      : setCookieHeader
        ? [setCookieHeader]
        : [];
    const sessionCookie = setCookies.find((cookie) => cookie.startsWith(`${sessionCookieName}=`));
    const sessionValue = sessionCookie
      ? sessionCookie.split(";")[0].slice(sessionCookieName.length + 1)
      : "";
    if (sessionValue) {
      await bru.cookies.upsert({
        key: sessionCookieName,
        value: sessionValue,
        path: "/",
        secure: baseUrl.startsWith("https://"),
        httpOnly: true,
        sameSite: "lax"
      });
    }
  }
}
