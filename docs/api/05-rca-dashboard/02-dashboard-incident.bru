meta {
  name: 02 Dashboard RCA Incident
  type: http
  seq: 2
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}/dashboard/rca/incidents/{{incident_id}}?cluster_id={{cluster_id}}
}

test {
  test("200 with item, 404 when incident is absent, or auth/access failure", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body has item", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("item");
    }
  });
}
