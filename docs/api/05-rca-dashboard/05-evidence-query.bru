meta {
  name: 05 Evidence 범용 조회
  type: http
  seq: 5
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}evidence?limit=20&offset=0
}

script:post-response {
  // correlation_id 가 있는 첫 row 자동 저장 — 06-rca-reports 필터에서 바로 사용 가능
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.items) && body.items.length > 0) {
    bru.setVar("rca_correlation_id", body.items[0].correlation_id);
  }
}

tests {
  test("200 with rows or explicit auth failure", function () {
    expect([200, 401, 422]).to.include(res.status);
  });

  test("success body has items array and pagination fields", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.items).to.be.an("array");
      expect(body).to.have.property("limit");
      expect(body).to.have.property("offset");
      expect(body).to.have.property("has_more");
    }
  });
}
