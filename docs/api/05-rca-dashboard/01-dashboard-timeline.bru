meta {
  name: 01 RCA Timeline 조회
  type: http
  seq: 1
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}dashboard/rca/timeline?cluster_id={{cluster_id}}&limit=20
}

script:post-response {
  // incident_id 가 있는 첫 row 자동 저장 — 02-dashboard-incident 에서 바로 사용 가능
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.items)) {
    const row = body.items.find((item) => item && item.incident_id);
    if (row) {
      bru.setVar("incident_id", row.incident_id);
    }
  }
}

tests {
  test("200 with rows or explicit auth/access failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has items array", function () {
    if (res.status === 200) {
      expect(res.getBody().items).to.be.an("array");
    }
  });
}
