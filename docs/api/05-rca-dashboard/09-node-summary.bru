meta {
  name: 09 노드 히트맵 요약
  type: http
  seq: 9
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}clusters/{{cluster_id}}/nodes/summary
}

tests {
  test("200 with node summary or explicit auth/access/not-found failure", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });

  test("success body has nodes array", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.cluster_id).to.be.a("string");
      expect(body.nodes).to.be.an("array");
    }
  });
}
