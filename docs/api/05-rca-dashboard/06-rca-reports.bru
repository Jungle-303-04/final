meta {
  name: 06 RCA Report 목록 조회
  type: http
  seq: 6
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}rca-reports?limit=20&offset=0
}

tests {
  test("200 with rows or explicit auth failure", function () {
    expect([200, 401, 422]).to.include(res.status);
  });

  test("success body has summary items without raw payload", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.items).to.be.an("array");
      expect(body).to.have.property("has_more");
      body.items.forEach((item) => {
        expect(item).to.have.property("root_cause");
        expect(item).to.have.property("action");
        expect(item).to.not.have.property("payload");
      });
    }
  });
}
