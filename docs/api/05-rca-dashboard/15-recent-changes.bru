meta {
  name: 15 Incident 최근 변경
  type: http
  seq: 15
  tags: [rca, gitops, changes, session, read]
}

get {
  url: {{base_url}}rca/incidents/{{incident_id}}/recent-changes?limit=5
}

tests {
  test("200 or concealed auth/not-found", function () {
    expect([200, 401, 404]).to.include(res.status);
  });

  test("success body exposes change references", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.items).to.be.an("array");
      expect(body).to.have.property("incident_id");
      body.items.forEach(function (item) {
        expect(item).to.have.property("changed_at");
        expect(item).to.have.property("commit_sha");
        expect(item).to.have.property("workflow_run_id");
        expect(item).to.have.property("image_before");
        expect(item).to.have.property("image_after");
        expect(item).to.have.property("pr_url");
      });
    }
  });
}
