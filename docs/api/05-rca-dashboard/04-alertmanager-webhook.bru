meta {
  name: 04 Alertmanager Webhook 수신
  type: http
  seq: 4
  tags: [
    rca
    alertmanager
    webhook
    evidence
  ]
}

post {
  url: {{base_url}}webhooks/alertmanager?cluster_id={{cluster_id}}&workspace_id={{workspace_id}}
  body: json
}

headers {
  content-type: application/json
  authorization: Bearer {{alertmanager_token}}
}

body:json {
  {
    "version": "4",
    "groupKey": "{}:{alertname=\"PodCrashLooping\"}",
    "status": "firing",
    "receiver": "bruno",
    "alerts": [
      {
        "status": "firing",
        "labels": {
          "alertname": "PodCrashLooping",
          "namespace": "{{namespace}}",
          "pod": "checkout-api-abc"
        },
        "annotations": {
          "summary": "pod restart threshold exceeded"
        },
        "startsAt": "2026-07-07T01:00:00Z",
        "endsAt": "",
        "fingerprint": "bruno-alert-001"
      }
    ]
  }
}

tests {
  test("webhook is accepted or protected clearly", function () {
    expect([200, 401, 404, 422, 503]).to.include(res.status);
  });

  test("success body has accepted shape", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("event_id");
      expect(body).to.have.property("correlation_id");
    }
  });
}
