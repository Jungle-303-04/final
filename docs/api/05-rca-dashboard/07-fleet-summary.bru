meta {
  name: 07 Fleet 요약 조회
  type: http
  seq: 7
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}fleet/summary
}

tests {
  test("200 with fleet rollup or explicit auth failure", function () {
    expect([200, 401]).to.include(res.status);
  });

  test("success body has clusters array and totals", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.clusters).to.be.an("array");
      expect(body.totals).to.be.an("object");
      expect(body.totals.clusters).to.be.a("number");
    }
  });

  test("every cluster item has a health rollup", function () {
    if (res.status === 200) {
      for (const item of res.getBody().clusters) {
        expect(["healthy", "warning", "critical", "unknown"]).to.include(item.health);
      }
    }
  });
}
