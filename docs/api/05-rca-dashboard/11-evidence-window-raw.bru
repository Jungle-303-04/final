meta {
  name: 11 Evidence Window 원문 조회
  type: http
  seq: 11
  tags: [
    dashboard
    session
    read
    debug
  ]
}

get {
  url: {{base_url}}evidence/windows/{{evidence_key}}?source={{evidence_source}}
}

tests {
  test("200 with raw evidence window or explicit unavailable/auth failure", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body has evidence window payload", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("evidence_key");
      expect(body).to.have.property("payload");
    }
  });
}
