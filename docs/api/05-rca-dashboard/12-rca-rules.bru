meta {
  name: 12 RCA 룰 목록
  type: http
  seq: 12
  tags: [rca, dashboard, rules]
}

get {
  url: {{base_url}}rca/rules
  body: none
}

tests {
  test("session can list loaded RCA rules or auth blocks clearly", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body has rule catalog summary", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("items");
      expect(body).to.have.property("rules_count");
      expect(body).to.have.property("candidates_count");
    }
  });
}
