meta {
  name: 10 노드 팟 히트맵 요약
  type: http
  seq: 10
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}clusters/{{cluster_id}}/nodes/{{node_name}}/pods/summary
}

tests {
  test("200 with pod summary or explicit auth/access/not-found failure", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });

  test("success body has pods array", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.cluster_id).to.be.a("string");
      expect(body.node_name).to.be.a("string");
      expect(body.pods).to.be.an("array");
    }
  });
}
