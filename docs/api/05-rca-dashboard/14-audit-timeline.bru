meta {
  name: 14 Audit correlation 타임라인
  type: http
  seq: 14
  tags: [rca, audit, timeline, session, read]
}

get {
  url: {{base_url}}audit/timeline?correlation_id={{rca_correlation_id}}&limit=50
}

tests {
  test("200 or session auth required", function () {
    expect([200, 401]).to.include(res.status);
  });

  test("success body exposes summaries without raw payload", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.items).to.be.an("array");
      expect(body).to.have.property("has_more");
      expect(body).to.have.property("next_cursor");
      body.items.forEach(function (item) {
        expect(item).to.have.property("subject");
        expect(item).to.have.property("source");
        expect(item).to.have.property("created_at");
        expect(item).to.have.property("payload_summary");
        expect(item).not.to.have.property("payload");
      });
    }
  });
}
