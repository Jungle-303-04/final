meta {
  name: 08 클러스터 드릴다운 요약
  type: http
  seq: 8
  tags: [
    dashboard
    session
    read
  ]
}

get {
  url: {{base_url}}clusters/{{cluster_id}}/summary
}

tests {
  test("200 with drilldown or explicit auth/access failure", function () {
    expect([200, 401, 403, 404]).to.include(res.status);
  });

  test("success body has workloads/warning_events/open_incidents", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body.workloads).to.be.an("object");
      expect(body.warning_events).to.be.an("array");
      expect(body.open_incidents).to.be.an("array");
      expect(["healthy", "warning", "critical", "unknown"]).to.include(body.health);
    }
  });
}
