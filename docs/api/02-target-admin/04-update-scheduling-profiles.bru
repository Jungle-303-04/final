meta {
  name: 04 Scheduling profile 수정
  type: http
  seq: 4
  tags: [
    target
    admin
    scheduling
  ]
}

put {
  url: {{base_url}}clusters/{{agent_cluster_id}}/scheduling-profiles
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "profiles": [
      {
        "profile_id": "checkout-fast",
        "enabled": true,
        "description": "checkout 계열 workload fast-lane",
        "selector": {
          "namespaces": [
            "sandbox",
            "payments"
          ],
          "labels": {
            "app.kubernetes.io/part-of": "checkout"
          },
          "workload_names": [
            "orders-api"
          ]
        },
        "priority_class_name": "gitops-fast-lane",
        "priority_value": 100000,
        "preemption_policy": "PreemptLowerPriority",
        "placement_mode": "preferred",
        "node_selector": {},
        "preferred_node_labels": {
          "workload-tier": "fast-lane"
        },
        "tolerations": [],
        "pre_pull_images": [
          "ghcr.io/example/orders-api:v1"
        ],
        "termination_grace_period_seconds": 1,
        "scheduler_name": null
      }
    ]
  }
}

tests {
  test("admin success or explicit auth/conflict response", function () {
    expect([200, 401, 403, 409, 422]).to.include(res.status);
  });
}
