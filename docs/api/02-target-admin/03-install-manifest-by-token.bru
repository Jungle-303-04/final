meta {
  name: 03 Agent 설치 Manifest 링크 조회
  type: http
  seq: 3
  tags: [
    target
    install
    manifest
  ]
}

get {
  url: {{base_url}}install/{{agent_token}}
}

tests {
  test("manifest link returns yaml or not-found", function () {
    expect([200, 404, 422]).to.include(res.status);
  });

  test("success body looks like kubernetes yaml", function () {
    if (res.status === 200) {
      const body = res.getBody();
      const text = typeof body === "string" ? body : JSON.stringify(body);
      expect(text).to.include("apiVersion:");
      expect(text).to.include("kind:");
    }
  });
}
