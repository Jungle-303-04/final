meta {
  name: 02 Update Cluster Policy
  type: http
  seq: 2
  tags: [
    target
    admin
    policy
  ]
}

put {
  url: {{base_url}}/clusters/{{cluster_id}}/policy
}

headers {
  content-type: application/json
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "generation": 2,
    "cluster_role": "target",
    "evidence": {
      "failure_policy": "allow_partial",
      "max_attempts": 3,
      "providers": {
        "kubernetes": {
          "enabled": true,
          "interval_seconds": 30,
          "min_workers": 1,
          "max_workers": 2,
          "queue_age_target_seconds": 15,
          "queries": [
            {
              "source": "kubernetes",
              "name": "cluster_snapshot",
              "namespace": "sandbox",
              "include_pods": true,
              "include_events": true,
              "include_nodes": true,
              "include_workloads": true,
              "include_services": true,
              "include_endpoints": true
            }
          ]
        },
        "metrics": {
          "enabled": true,
          "interval_seconds": 30,
          "min_workers": 1,
          "max_workers": 2,
          "queue_age_target_seconds": 15,
          "queries": [
            {
              "source": "prometheus",
              "name": "pod_restart_rate",
              "query": "sum(rate(kube_pod_container_status_restarts_total[5m]))",
              "range_seconds": 300,
              "step_seconds": 30
            }
          ]
        }
      }
    },
    "bootstrap": {
      "mode": "target",
      "resources": []
    },
    "desired_state": {
      "resources": []
    }
  }
}

tests {
  test("admin success or explicit auth/conflict response", function () {
    expect([200, 401, 403, 409, 422]).to.include(res.status);
  });

  test("success response includes policy", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accepted", true);
      expect(body).to.have.property("policy");
    }
  });
}
