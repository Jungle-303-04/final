meta {
  name: 01 Target 등록과 Manifest 발급
  type: http
  seq: 1
  tags: [
    target
    admin
    write
  ]
}

post {
  url: {{base_url}}targets
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "cluster_id": "{{agent_cluster_id}}",
    "name": "{{agent_target_name}}",
    "environment": "test",
    "management_base_url": "{{management_base_url}}",
    "image": "{{service_image}}",
    "prometheus_base_url": "http://prometheus.target.svc:9090",
    "loki_base_url": "http://loki-gateway.target.svc",
    "tempo_base_url": "http://tempo.target.svc:3200",
    "otel_traces_endpoint": "http://opentelemetry-collector.target.svc:4318/v1/traces",
    "evidence_interval_seconds": 30,
    "install_node_collector": true,
    "install_sample_workload": false,
    "apply": false,
    "cloud_provider": "existing-k8s",
    "deploy_provider": "manual-manifest"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.agent_token) {
    bru.setVar("agent_token", body.agent_token);
  }
}

tests {
  test("admin success or explicit auth failure", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success response returns manifest and agent token", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("registered", true);
      expect(body).to.have.property("install_manifest");
      expect(body).to.have.property("agent_token");
      expect(body).to.have.property("applied", false);
      expect(body).to.have.property("management_access");
      expect(body.management_access).to.have.property("mode");
      expect(body.management_access).to.have.property("agent_server_url");
      expect(["external", "self_only"]).to.include(body.management_access.reachability);
    }
  });
}
