meta {
  name: 01 Provider 목록 조회
  type: http
  seq: 1
  tags: [
    providers
    admin
  ]
}

get {
  url: {{base_url}}providers/catalog
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("catalog contains providers", function () {
    expect(res.getBody()).to.have.property("providers");
  });
}
