meta {
  name: 02 Provider 선택 검증
  type: http
  seq: 2
  tags: [
    providers
    admin
  ]
}

post {
  url: {{base_url}}providers/validate
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "source_provider": "github",
    "deploy_provider": "manual-manifest",
    "cloud_provider": "existing-k8s",
    "secret_provider": "env",
    "capabilities": [
      "gitops",
      "target-agent",
      "evidence"
    ],
    "credential_refs": {}
  }
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("validation response shape", function () {
    const body = res.getBody();
    expect(body).to.have.property("valid");
    expect(body.errors).to.be.an("array");
    expect(body.warnings).to.be.an("array");
    expect(body).to.have.property("selected");
  });
}
