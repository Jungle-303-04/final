meta {
  name: 02 저장소 branch 목록
  type: http
  seq: 2
  tags: [repository-discovery, read]
}

get {
  url: {{base_url}}repositories/discovery/branches?repo_ref={{repo_ref}}
}

script:post-response {
  const b = res.getBody();
  if (res.status === 200 && b && b.default_branch) {
    bru.setVar("default_branch", b.default_branch);
  }
}

tests {
  test("200 or auth/discovery failure", function () {
    expect([200, 401, 403, 404, 422, 502]).to.include(res.status);
  });
}
