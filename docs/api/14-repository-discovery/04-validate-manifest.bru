meta {
  name: 04 Manifest 검증
  type: http
  seq: 4
  tags: [repository-discovery, read]
}

post {
  url: {{base_url}}repositories/discovery/validate
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "repo_ref": "{{repo_ref}}",
    "branch": "{{default_branch}}",
    "manifest_path": "{{manifest_path}}",
    "source_type": "{{source_type}}"
  }
}

tests {
  test("200 or auth/discovery failure", function () {
    expect([200, 401, 403, 404, 422, 502]).to.include(res.status);
  });
  test("success has validation shape", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("valid");
      expect(res.getBody()).to.have.property("resources");
    }
  });
}
