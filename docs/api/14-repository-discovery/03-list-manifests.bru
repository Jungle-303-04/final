meta {
  name: 03 Manifest 후보 목록
  type: http
  seq: 3
  tags: [repository-discovery, read]
}

post {
  url: {{base_url}}repositories/discovery/manifests
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "repo_ref": "{{repo_ref}}",
    "branch": "{{default_branch}}"
  }
}

script:post-response {
  const b = res.getBody();
  if (res.status === 200 && b && Array.isArray(b.candidates) && b.candidates.length) {
    bru.setVar("manifest_path", b.candidates[0].path);
    bru.setVar("source_type", b.candidates[0].source_type);
  }
}

tests {
  test("200 or auth/discovery failure", function () {
    expect([200, 401, 403, 404, 422, 502]).to.include(res.status);
  });
}
