meta {
  name: 03 저장소 URL 검증
  type: http
  seq: 3
  tags: [repo, wizard, validation]
}

post {
  url: {{base_url}}repos/validate
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "url": "{{repo_ref}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.normalized) {
    bru.setVar("repo_ref", body.normalized);
  }
}

tests {
  test("admin can validate repo or auth/discovery blocks clearly", function () {
    expect([200, 401, 403, 404, 422, 502]).to.include(res.status);
  });

  test("success body is normalized and branch-aware", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("accessible");
      expect(body).to.have.property("normalized");
      expect(body).to.have.property("default_branch");
    }
  });
}
