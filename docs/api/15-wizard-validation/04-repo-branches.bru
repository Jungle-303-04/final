meta {
  name: 04 저장소 branch 리스트
  type: http
  seq: 4
  tags: [repo, wizard, read]
}

get {
  url: {{base_url}}repos/branches?repo={{repo_ref}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.default_branch) {
    bru.setVar("default_branch", body.default_branch);
  }
}

tests {
  test("admin can list branches or auth/discovery blocks clearly", function () {
    expect([200, 401, 403, 404, 422, 502]).to.include(res.status);
  });

  test("success body has branch list", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("branches");
      expect(body.branches).to.be.an("array");
    }
  });
}
