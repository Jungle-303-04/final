meta {
  name: 05 첨부 가능 manifest 리스트
  type: http
  seq: 5
  tags: [repo, wizard, read]
}

get {
  url: {{base_url}}repos/manifests?repo={{repo_ref}}&branch={{default_branch}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.manifests) && body.manifests.length) {
    bru.setVar("manifest_path", body.manifests[0].path);
  }
}

tests {
  test("admin can list attachable manifests or auth/discovery blocks clearly", function () {
    expect([200, 401, 403, 404, 422, 502]).to.include(res.status);
  });

  test("success body has k8s kind metadata", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("manifests");
      expect(body.manifests).to.be.an("array");
    }
  });
}
