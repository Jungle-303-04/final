meta {
  name: 08 PromQL agent 검증
  type: http
  seq: 8
  tags: [metrics, wizard, validation]
}

post {
  url: {{base_url}}metrics/validate
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "cluster_id": "{{cluster_id}}",
    "query": {
      "source": "prometheus",
      "name": "promql_validation",
      "query": "up",
      "range_seconds": 300,
      "step_seconds": 30
    }
  }
}

tests {
  test("agent validation is accepted or access is rejected clearly", function () {
    expect([202, 401, 403, 409, 422]).to.include(res.status);
  });

  test("accepted body has the resumable agent command identity", function () {
    if (res.status === 202) {
      const body = res.getBody();
      expect(body.accepted).to.equal(true);
      expect(body.command_id).to.be.a("string").and.not.empty;
      expect(body.correlation_id).to.be.a("string").and.not.empty;
    }
  });
}
