meta {
  name: 06 알림 채널 테스트 발송
  type: http
  seq: 6
  tags: [alert, wizard, validation]
}

post {
  url: {{base_url}}alert-channels/test
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "bruno-validation",
    "kind": "webhook",
    "url": "{{alert_webhook_url}}",
    "min_severity": "warning",
    "severity": "warning",
    "message": "Bruno alert channel validation"
  }
}

tests {
  test("admin can test alert channel or auth/validation blocks clearly", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success response is machine-readable", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("valid");
      expect(body).to.have.property("delivered");
      expect(body).to.have.property("detail");
    }
  });
}
