meta {
  name: 07 RCA 룰 YAML 검증
  type: http
  seq: 7
  tags: [rca, wizard, validation]
}

post {
  url: {{base_url}}rca/rules/validate
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "yaml_text": "rules:\n  - id: bruno_dns\n    symptoms: [\"DNS lookup failed\"]\n    required_sources: [\"kubernetes\", \"logs\"]\n    candidates:\n      - candidate_id: service_dns_resolution_failure\n        title: 서비스 DNS 실패\n        description: 서비스 이름 해석이 실패했습니다.\n        expected_evidence: [\"kubernetes\", \"logs\"]\n        checks:\n          - CoreDNS 이벤트 확인\n"
  }
}

tests {
  test("session can validate RCA rule yaml or auth/validation blocks clearly", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has validation result", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("valid");
      expect(body).to.have.property("errors");
    }
  });
}
