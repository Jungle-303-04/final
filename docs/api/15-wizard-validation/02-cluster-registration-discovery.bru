meta {
  name: 02 클러스터 등록 폼 메타데이터
  type: http
  seq: 2
  tags: [providers, target, wizard, read]
}

get {
  url: {{base_url}}providers/cluster-discovery
}

tests {
  test("admin can read cluster discovery or auth blocks clearly", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body has provider flows", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("flows");
      expect(body.flows.map((flow) => flow.cloud_provider)).to.include("eks");
    }
  });
}
