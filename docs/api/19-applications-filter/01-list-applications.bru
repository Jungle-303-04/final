meta {
  name: 01 Applications 필터 조회
  type: http
  seq: 1
  tags: [applications, filters, read]
}
get {
  url: {{base_url}}applications/filter-results?clusters={{cluster_id}}&limit=50
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("200 response exposes provider-neutral partial projection", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    expect(body).to.have.property("counts");
    expect(body).to.have.property("capabilities");
    expect(body.snapshot).to.have.property("snapshot_revision", 0);
    expect(body.snapshot.partial_reason_codes).to.include("mutable_application_projection");
  });
}
