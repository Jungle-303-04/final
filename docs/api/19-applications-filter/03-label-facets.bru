meta {
  name: 03 Applications 라벨 facet 가용성
  type: http
  seq: 3
  tags: [applications, filters, labels, read]
}
get {
  url: {{base_url}}applications/label-facets?clusters={{cluster_id}}&facet_q=team&limit=50
}

tests {
  test("200 or validated access failure", function () {
    expect([200, 400, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("200 response reports label projection honestly", function () {
    if (res.status !== 200) return;
    const body = res.getBody();
    expect(body.surface).to.equal("applications");
    expect(body.items).to.be.an("array");
    expect(body.selected_resolutions).to.be.an("array");
    const labels = body.capabilities.find((item) => item.axis === "labels");
    expect(labels.availability).to.equal("unavailable");
  });
}
