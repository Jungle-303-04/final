meta {
  name: 11 권한 부여
  type: http
  seq: 11
  tags: [
    management
    access
    admin
    write
  ]
}

post {
  url: {{base_url}}access
}

headers {
  content-type: application/json
}

body:json {
  {
    "subject_type": "user",
    "subject_id": "{{user_id}}",
    "subject_label": "{{auth_email}}",
    "resource_type": "cluster",
    "resource_id": "{{cluster_id}}",
    "role": "cluster_steward"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.access_id) {
    bru.setVar("access_id", body.access_id);
  }
}

tests {
  test("admin can grant access or validation/auth blocks clearly", function () {
    expect([200, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("success body has access fields", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("access_id");
      expect(body).to.have.property("resource_id");
      expect(body).to.have.property("role");
    }
  });
}
