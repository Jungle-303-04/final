meta {
  name: 01 조직 목록 조회
  type: http
  seq: 1
  tags: [
    management
    org
    admin
    read
  ]
}

get {
  url: {{base_url}}orgs
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.orgs) && body.orgs.length) {
    bru.setVar("org_id", body.orgs[0].org_id);
  }
}

tests {
  test("admin can list orgs or auth blocks clearly", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body has orgs array", function () {
    if (res.status === 200) {
      expect(res.getBody().orgs).to.be.an("array");
    }
  });
}
