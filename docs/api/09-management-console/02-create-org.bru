meta {
  name: 02 조직 생성
  type: http
  seq: 2
  tags: [
    management
    org
    admin
    write
  ]
}

post {
  url: {{base_url}}orgs
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Bruno Practice Org",
    "description": "created from Bruno management console practice"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.org_id) {
    bru.setVar("created_org_id", body.org_id);
  }
}

tests {
  test("admin can create org or validation/auth blocks clearly", function () {
    expect([200, 401, 403, 409, 422]).to.include(res.status);
  });

  test("success body has org fields", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("org_id");
      expect(body).to.have.property("name");
      expect(body).to.have.property("member_count");
      expect(body).to.have.property("group_count");
    }
  });
}
