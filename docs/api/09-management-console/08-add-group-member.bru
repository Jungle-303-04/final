meta {
  name: 08 그룹 멤버 추가
  type: http
  seq: 8
  tags: [
    management
    groups
    admin
    write
  ]
}

put {
  url: {{base_url}}groups/{{group_id}}/members/{{user_id}}
}

tests {
  test("admin can add member or auth/not-found blocks clearly", function () {
    expect([200, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("success body is accepted", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("accepted", true);
    }
  });
}
