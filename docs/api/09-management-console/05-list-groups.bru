meta {
  name: 05 그룹 목록 조회
  type: http
  seq: 5
  tags: [
    management
    groups
    admin
    read
  ]
}

get {
  url: {{base_url}}groups?org_id={{org_id}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.groups) && body.groups.length) {
    bru.setVar("group_id", body.groups[0].group_id);
  }
}

tests {
  test("admin can list groups or auth blocks clearly", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has groups array", function () {
    if (res.status === 200) {
      expect(res.getBody().groups).to.be.an("array");
    }
  });
}
