meta {
  name: 06 그룹 생성
  type: http
  seq: 6
  tags: [
    management
    groups
    admin
    write
  ]
}

post {
  url: {{base_url}}groups
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "org_id": "{{org_id}}",
    "name": "bruno-practice-group",
    "description": "created from Bruno"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.group_id) {
    bru.setVar("group_id", body.group_id);
  }
}

tests {
  test("admin can create group or validation/auth blocks clearly", function () {
    expect([200, 401, 403, 404, 409, 422]).to.include(res.status);
  });

  test("success body has group fields", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("group_id");
      expect(body).to.have.property("org_id");
      expect(body).to.have.property("name");
    }
  });
}
