meta {
  name: 10 권한 목록 조회
  type: http
  seq: 10
  tags: [
    management
    access
    read
  ]
}

get {
  url: {{base_url}}access?resource_id={{cluster_id}}
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.grants) && body.grants.length) {
    bru.setVar("access_id", body.grants[0].access_id);
  }
}

tests {
  test("session can list grants or auth blocks clearly", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has grants array", function () {
    if (res.status === 200) {
      expect(res.getBody().grants).to.be.an("array");
    }
  });
}
