meta {
  name: 07 그룹 멤버 목록 조회
  type: http
  seq: 7
  tags: [
    management
    groups
    admin
    read
  ]
}

get {
  url: {{base_url}}groups/{{group_id}}/members
}

tests {
  test("admin can list group members or auth/not-found blocks clearly", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body has members array", function () {
    if (res.status === 200) {
      expect(res.getBody().members).to.be.an("array");
    }
  });
}
