meta {
  name: 04 사용자 목록 조회
  type: http
  seq: 4
  tags: [
    management
    users
    admin
    read
  ]
}

get {
  url: {{base_url}}users?status=approved
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.users) && body.users.length) {
    bru.setVar("user_id", body.users[0].user_id);
  }
}

tests {
  test("admin can list users or auth blocks clearly", function () {
    expect([200, 401, 403, 422]).to.include(res.status);
  });

  test("success body has users array", function () {
    if (res.status === 200) {
      expect(res.getBody().users).to.be.an("array");
    }
  });
}
