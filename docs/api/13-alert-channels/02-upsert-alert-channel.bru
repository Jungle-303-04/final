meta {
  name: 02 알림 채널 생성 또는 수정
  type: http
  seq: 2
  tags: [
    alert
    admin
    routing
    write
  ]
}

post {
  url: {{base_url}}alert-channels
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "bruno-disabled-ops-channel",
    "kind": "webhook",
    "url": "{{alert_webhook_url}}",
    "min_severity": "warning",
    "enabled": false
  }
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && body.channel_id) {
    bru.setVar("alert_channel_id", body.channel_id);
  }
}

tests {
  test("admin can upsert alert channel or auth/validation blocks clearly", function () {
    expect([200, 401, 403, 404, 422]).to.include(res.status);
  });

  test("success body has alert channel fields", function () {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.have.property("channel_id");
      expect(body).to.have.property("workspace_id");
      expect(body).to.have.property("name", "bruno-disabled-ops-channel");
      expect(body).to.have.property("kind", "webhook");
      expect(body).to.have.property("enabled", false);
    }
  });
}
