meta {
  name: 01 알림 채널 목록 조회
  type: http
  seq: 1
  tags: [
    alert
    admin
    routing
  ]
}

get {
  url: {{base_url}}alert-channels
}

script:post-response {
  const body = res.getBody();
  if (res.status === 200 && body && Array.isArray(body.channels) && body.channels.length > 0) {
    bru.setVar("alert_channel_id", body.channels[0].channel_id);
  }
}

tests {
  test("admin can list alert channels or auth blocks clearly", function () {
    expect([200, 401, 403]).to.include(res.status);
  });

  test("success body has channels array", function () {
    if (res.status === 200) {
      expect(res.getBody()).to.have.property("channels");
      expect(res.getBody().channels).to.be.an("array");
    }
  });
}
