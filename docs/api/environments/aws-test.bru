vars {
  base_url: https://k8s.woonyong.org/
  auth_email: admin.local@example.com
  auth_password: local-test-password-1234
  signup_email: teammate@example.com
  signup_password: teammate-password-1234
  email_verification_token: replace-with-token-from-mail-event
  user_id: auto-set-after-login
  workspace_id: default
  cluster_id: cluster-1
  cluster_id_2: cluster-2
  agent_cluster_id: bruno-api-test
  target_name: cluster-1
  agent_target_name: Bruno API Test Target
  management_base_url: https://k8s.woonyong.org/
  service_image: 183548421506.dkr.ecr.ap-northeast-2.amazonaws.com/kubernetes-ops-service:4cb1f247eebec806e1191e72c9763557b55b027d
  namespace: sandbox
  deployment_name: checkout-api
  repo_ref: Jungle-303-04/final
  default_branch: main
  manifest_path: src/samples/smoke/deploy.yaml
  application_id: auto-set-after-application-create-or-list
  agent_token: auto-set-after-target-register
  agent_id: target-agent
  command_id: auto-set-after-debug-query-or-poll
  lease_id: lease-manual-001
  evidence_key: aws-window-001
  evidence_job_id: auto-set-after-evidence-job-poll
  provider_key: kubernetes
  catalog_item_id: auto-set-after-catalog-list
  plan_id: replace-with-recovery-plan-id
  action_id: replace-with-recovery-action-id
  approval_id: replace-with-approval-id
  dead_letter_id: auto-set-after-dead-letters-list
  conversation_id: auto-set-after-create-conversation
  incident_id: auto-set-after-dashboard-timeline
  org_id: auto-set-after-org-create-or-list
  created_org_id: auto-set-after-org-create
  group_id: auto-set-after-group-create-or-list
  access_id: auto-set-after-access-grant
  alert_channel_id: auto-set-after-alert-channel-upsert
  alert_webhook_url: https://example.invalid/service-alerts
  metrics_token: replace-with-metrics-token-if-enabled
  alertmanager_token: replace-with-ALERTMANAGER_WEBHOOK_TOKEN
  github_webhook_secret: replace-with-GITHUB_WEBHOOK_SECRET
  github_webhook_signature: auto-set-when-secret-is-filled
}
